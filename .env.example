# Supabase — copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local (they are already in .gitignore).

# ค่าที่หาได้จาก Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# service role key ใช้เฉพาะฝั่ง server เท่านั้น ห้ามใช้ในโค้ดที่ส่งถึง browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
